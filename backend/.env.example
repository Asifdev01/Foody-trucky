PORT=5000
MONGODB_URI=mongodb://localhost:27017/share2serve
JWT_SECRET=your_super_secret_key_here
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Access/refresh token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Rate limiting
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_FOOD_DONATION_MAX=20

# Admin seed script (scripts/seedAdmin.js) — required in production
ADMIN_SEED_EMAIL=admin@share2serve.com
ADMIN_SEED_PASSWORD=change_me_in_production
