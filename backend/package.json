{
  "name": "share2serve-backend",
  "version": "1.0.0",
  "description": "Backend API for Share2Serve authentication",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node scripts/seedAdmin.js",
